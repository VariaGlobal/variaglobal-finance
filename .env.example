# Vercel AI Gateway
# Create a key: Vercel dashboard -> AI Gateway -> API keys,
# then add AI_GATEWAY_API_KEY to the variaglobal-finance project env (all environments).
AI_GATEWAY_API_KEY=

# Optional overrides
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_SUGGEST_MODEL=anthropic/claude-haiku-4.5

# Composio — server-side pipeline access to Mercury/Asana/HubSpot connections
# (create in dashboard.composio.dev -> Settings -> API Keys)
COMPOSIO_API_KEY=

# One-shot bootstrap/integrity route token (any value; set in Vercel env)
BOOTSTRAP_TOKEN=
